      "fields": {
        "entry_id": {
          "name": "Entry-ID",
          "description": "Optionale Config-Entry-ID, um nur für ein Kaschuetz-Gerät zu berechnen."
        }
      }
    },
    "preview_only": {
      "name": "Nur Vorschau",
      "description": "Zeigt eine schreibgeschützte Optimierungsvorschau mit Ist-Werten, Vorschlagswerten und Delta. Es werden keine Werte geschrieben.",
      "fields": {
        "entry_id": {
          "name": "Entry-ID",
          "description": "Optionale Config-Entry-ID, um die Vorschau nur für ein Kaschuetz-Gerät zu berechnen."
        }
      }
    },
    "export_burn_history": {
      "name": "Abbrandverlauf exportieren",
