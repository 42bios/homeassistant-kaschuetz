        "entry_id": {
          "name": "Entry-ID",
          "description": "Optionale Config-Entry-ID, um nur für ein Kaschuetz-Gerät zu exportieren."
        },
        "include_arrays": {
          "name": "Arrays inkludieren",
          "description": "TempArr und KlappeArr in den Export aufnehmen."
        },
        "max_points": {
          "name": "Maximale Punkte",
          "description": "Maximale Anzahl an Verlaufspunkten aus dem Ende der Arrays."
        }
      }
    },
    "export_burn_history_file": {
      "name": "Abbrandverlauf als Datei exportieren",
