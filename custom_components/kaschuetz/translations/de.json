        "entry_id": {
          "name": "Entry-ID",
          "description": "Optionale Config-Entry-ID, um nur für ein Kaschuetz-Gerät zu exportieren."
        },
        "include_arrays": {
          "name": "Arrays inkludieren",
          "description": "TempArr und KlappeArr in den Export aufnehmen."
        },
        "max_points": {
          "name": "Maximale Punkte",
          "description": "Maximale Anzahl an Verlaufspunkten aus dem Ende der Arrays."
        },
        "format": {
          "name": "Dateiformat",
          "description": "Ausgabeformat für die Exportdatei."
        }
      }
    },
    "apply_optimization": {
      "name": "Optimierung anwenden",
      "description": "Übernimmt vorgeschlagene Abbrandparameter in die Optionen und schreibt sie optional auf das Gerät. Erfordert aktivierte experimentelle Auto-Optimierung in den Optionen.",
      "fields": {
        "entry_id": {
          "name": "Entry-ID",
          "description": "Optionale Config-Entry-ID, um Einstellungen nur für ein Kaschuetz-Gerät anzuwenden."
        },
        "write_to_device": {
          "name": "Auf Gerät schreiben",
          "description": "Sendet Werte vor dem Speichern per rqType=8 an den Ofen."
        },
        "min_confidence": {
          "name": "Mindestvertrauen",
          "description": "Wendet Optimierung nur an, wenn das Vertrauen mindestens diesem Wert entspricht."
        }
      }
    },
    "optimize_and_apply": {
      "name": "Optimieren und anwenden",
