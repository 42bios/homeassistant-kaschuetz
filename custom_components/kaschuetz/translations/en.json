  "services": {
    "calculate_optimization": {
      "name": "Calculate Optimization",
      "description": "Create a suggested set of burn parameters from observed Kaschuetz burn data.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Optional config entry ID to calculate for one Kaschuetz device only."
        }
      }
    },
    "preview_only": {
      "name": "Preview Only",
      "description": "Show a read-only optimization preview with current values, suggested values, and deltas. No values are written.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Optional config entry ID to preview one Kaschuetz device only."
        }
      }
    },
    "apply_optimization": {
      "name": "Apply Optimization",
      "description": "Apply suggested burn parameters to options and optionally write them to the device. Requires experimental auto optimization to be enabled in options.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Optional config entry ID to apply settings for one Kaschuetz device only."
        },
        "write_to_device": {
          "name": "Write to device",
          "description": "Send values to the oven with rqType=8 before saving options."
        },
        "min_confidence": {
          "name": "Minimum confidence",
          "description": "Only apply optimization when confidence is at least this level."
        }
      }
    },
    "optimize_and_apply": {
      "name": "Optimize And Apply",
      "description": "Shortcut for apply_optimization with confidence gating. Requires experimental auto optimization to be enabled in options.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Optional config entry ID to apply settings for one Kaschuetz device only."
        },
        "write_to_device": {
          "name": "Write to device",
          "description": "Send values to the oven with rqType=8 before saving options."
        },
        "min_confidence": {
          "name": "Minimum confidence",
          "description": "Only apply optimization when confidence is at least this level."
        }
      }
    },
    "reset_optimization_data": {
      "name": "Reset Optimization Data",
      "description": "Delete observed burn samples used by the optimizer.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Optional config entry ID to reset data for one Kaschuetz device only."
        }
      }
    }
